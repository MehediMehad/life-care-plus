# /server/.env.example
# ==========================================
# Core Server Configuration
# ==========================================
NODE_ENV=development 
LOG_LEVEL=debug
PORT=5000 

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Database & Caching
# ==========================================
# Use @db for docker, or @localhost for local setup
DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<database_name>"
REDIS_URL="redis://localhost:6379"

# ==========================================
# Admin Setup (Auto-seeded on first run)
# ==========================================
SUPER_ADMIN_EMAIL="super_admin@example.com"
SUPER_ADMIN_PASSWORD="<set_your_strong_password>"

# ==========================================
# Authentication & JWT
# ==========================================
SALT_ROUND=10 

# Run 'openssl rand -base64 32' to generate secrets
JWT_SECRET="<your_jwt_access_token_secret>"
REFRESH_TOKEN_SECRET="<your_jwt_refresh_token_secret>"

EXPIRES_IN=7d 
REFRESH_TOKEN_EXPIRES_IN=1y 

RESET_PASS_TOKEN="<your_reset_pass_token_secret>"
RESET_PASS_TOKEN_EXPIRES_IN=5m 

EXPRESS_SESSION_SECRET="<your_express_session_secret>"

# ==========================================
# Application URLs
# ==========================================
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000/api/v1"
RESET_PASS_LINK="http://localhost:3000/reset-password"

# ==========================================
# Email Service (Nodemailer)
# ==========================================
EMAIL="<your_email@gmail.com>" 
APP_PASS="<your_gmail_app_password_16_chars>"

# ==========================================
# Cloudinary (Image Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME="<your_cloudinary_cloud_name>"
CLOUDINARY_API_KEY="<your_cloudinary_api_key>"
CLOUDINARY_API_SECRET="<your_cloudinary_api_secret>"

# ==========================================
# Stripe (Payments)
# ==========================================
STRIPE_PUBLISHABLE_KEY="<your_stripe_publishable_key>"
STRIPE_SECRET_KEY="<your_stripe_secret_key>"
STRIPE_WEBHOOK_SECRET="<your_stripe_webhook_secret>"

# ==========================================
# OAuth (Google & Facebook)
# ==========================================
GOOGLE_CLIENT_ID="<your_google_client_id>"
GOOGLE_CLIENT_SECRET="<your_google_client_secret>"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

FACEBOOK_APP_ID="<your_facebook_app_id>"
FACEBOOK_APP_SECRET="<your_facebook_app_secret>"
FACEBOOK_CALLBACK_URL="http://localhost:5000/api/v1/auth/facebook/callback"

# ==========================================
# Twilio (SMS Notifications)
# ==========================================
TWILIO_ACCOUNT_SID="<your_twilio_account_sid>"
TWILIO_AUTH_TOKEN="<your_twilio_auth_token>"
TWILIO_PHONE_NUMBER="<your_twilio_phone_number>" 

# ==========================================
# Web Push (Browser Notifications)
# ==========================================
# Run 'npx web-push generate-vapid-keys' to generate
VAPID_PUBLIC_KEY="<your_vapid_public_key>"
VAPID_PRIVATE_KEY="<your_vapid_private_key>"
VAPID_SUBJECT="mailto:<admin_email_for_vapid@example.com>"

# ==========================================
# WebRTC (Video Calls via Daily.co)
# ==========================================
DAILY_API_KEY="<your_daily_co_api_key>"

# ==========================================
# Logging & Error Tracking (Sentry)
# ==========================================
SENTRY_DSN="<your_sentry_dsn_url>"

# ==========================================
# AI Models (Optional)
# ==========================================
OPENROUTER_API_KEY="<your_openrouter_api_key>"
